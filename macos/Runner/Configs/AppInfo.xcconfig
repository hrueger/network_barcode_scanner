// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = Network Barcode Scanner

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.hannesrueger.networkBarcodeScanner

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2025 Hannes Rüger. All rights reserved.

// Sign with the personal team (same as iOS) instead of ad hoc: macOS ties
// Accessibility and Input Monitoring grants to the signature.
DEVELOPMENT_TEAM = M273PG74WU
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development

// Notarization rejects an app without the hardened runtime
ENABLE_HARDENED_RUNTIME = YES

// Release builds switch signing here: Developer ID for GitHub, Apple
// Distribution with a provisioning profile for the Mac App Store. fastlane
// writes this file (see macos/fastlane/Fastfile) and deletes it again; it is
// gitignored.
#include? "Signing.xcconfig"
