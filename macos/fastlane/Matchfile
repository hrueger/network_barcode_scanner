# Where the Developer ID certificate lives.
#
# The same private certificates repo as technikpool: match keeps certificates
# per team, and a Developer ID certificate signs every app of the team, so
# nothing here is specific to this app. MATCH_GIT_URL and MATCH_PASSWORD are
# the technikpool values.
#
# Getting the existing certificate into the repo, once, on a Mac that has it
# in the keychain: export it as .cer and as .p12 with its private key and an
# empty password, then
#   MATCH_GIT_URL=... MATCH_PASSWORD=... fastlane mac import_developer_id \
#     cert:/path/to/devid.cer p12:/path/to/devid.p12
# This does not create a certificate. Apple allows only a few Developer ID
# certificates per team, so never let match mint one by running it with
# readonly false.
git_url(ENV.fetch('MATCH_GIT_URL', ''))
storage_mode('git')

type('developer_id')
platform('macos')
app_identifier(['com.hannesrueger.networkBarcodeScanner'])
readonly(true)
