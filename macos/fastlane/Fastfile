# The macOS app, two ways: a notarized DMG for the GitHub release, and the
# Mac App Store.
#
#   bundle exec fastlane mac build              # signed DMG, not notarized; runs locally
#   bundle exec fastlane mac release            # build + notarize + staple; what CI runs
#   bundle exec fastlane mac appstore_setup     # once, by hand: App Store profile + installer cert
#   bundle exec fastlane mac appstore_release   # build, upload, submit; what CI runs
#
# Version comes from pubspec.yaml; these lanes never invent one.
#
# Locally the Developer ID certificate comes from your keychain. On CI it comes
# from match (see Matchfile), which needs MATCH_GIT_URL and MATCH_PASSWORD.
# Notarizing needs an App Store Connect API key: ASC_KEY_ID, ASC_ISSUER_ID and
# ASC_KEY_PATH (path to the .p8), the same key technikpool uses.

require 'fileutils'
require 'tmpdir'

default_platform(:mac)

# __dir__ is macos/fastlane, so this is the Flutter project root
FLUTTER_PROJECT = File.expand_path('../..', __dir__)
APP_NAME = 'Network Barcode Scanner'
APP_IDENTIFIER = 'com.hannesrueger.networkBarcodeScanner'
PKG = File.join(FLUTTER_PROJECT, 'build/macos/network-barcode-scanner.pkg')
APP = File.join(FLUTTER_PROJECT, "build/macos/Build/Products/Release/#{APP_NAME}.app")
DMG_DIR = File.join(FLUTTER_PROJECT, 'build/dmg')
SIGNING_XCCONFIG = File.expand_path('../Runner/Configs/Signing.xcconfig', __dir__)

# fastlane's Ruby environment leaks into child processes, and CocoaPods,
# which `flutter build macos` runs, then fails to load its own gems.
RUBY_ENV = %w[GEM_HOME GEM_PATH RUBYOPT RUBYLIB BUNDLE_GEMFILE BUNDLE_BIN_PATH BUNDLER_VERSION BUNDLER_SETUP].freeze

def flutter(*args)
  saved = RUBY_ENV.to_h { |name| [name, ENV.delete(name)] }
  Dir.chdir(FLUTTER_PROJECT) { sh('flutter', *args) }
ensure
  saved.each { |name, value| ENV[name] = value if value }
end

def version
  line = File.read(File.join(FLUTTER_PROJECT, 'pubspec.yaml'))[/^version:\s*(\S+)/, 1]
  UI.user_error!('No version in pubspec.yaml') unless line
  line.split('+').first
end

def dmg_path
  File.join(DMG_DIR, "network-barcode-scanner-#{version}-macos.dmg")
end

def asc_key
  %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH].each do |name|
    UI.user_error!("#{name} is not set, see the comment at the top of this Fastfile") if
      ENV[name].to_s.empty?
  end
  app_store_connect_api_key(
    key_id: ENV.fetch('ASC_KEY_ID'),
    issuer_id: ENV.fetch('ASC_ISSUER_ID'),
    key_filepath: ENV.fetch('ASC_KEY_PATH'),
    in_house: false
  )
end

# On CI the runner's keychain is empty, so fetch the certificate from match
# into a throwaway keychain. Locally the login keychain already has it.
def install_certificate
  return unless is_ci
  %w[MATCH_GIT_URL MATCH_PASSWORD].each do |name|
    UI.user_error!("#{name} is not set, see macos/fastlane/Matchfile") if ENV[name].to_s.empty?
  end
  setup_ci
  match(type: 'developer_id', skip_provisioning_profiles: true)
end

# The SHA-1 of the certificate that signed the app. Naming the identity is
# ambiguous when the keychain holds a renewed certificate next to the old one,
# which is common for Developer ID.
def signing_identity_of(path)
  Dir.mktmpdir do |dir|
    sh('codesign', '-d', "--extract-certificates=#{dir}/cert", path, log: false)
    sh('openssl', 'x509', '-inform', 'DER', '-in', "#{dir}/cert0", '-noout', '-fingerprint', '-sha1',
       log: false).split('=').last.delete(':').strip
  end
end

# The App Review contact and notes. deliver only creates the review details
# of a new version when given them, and fails reading them otherwise. Name
# and email are public on the privacy page anyway; the phone number is a
# secret, since this repository is public.
def app_review_information(notes)
  phone = ENV['APP_REVIEW_PHONE'].to_s
  UI.user_error!('APP_REVIEW_PHONE is not set, App Review needs a phone number') if phone.empty?
  {
    first_name: 'Hannes',
    last_name: 'Rüger',
    email_address: 'kontakt@rueger.events',
    phone_number: phone,
    notes: notes
  }
end

# Builds the app with the signing settings in [xcconfig] layered over
# AppInfo.xcconfig, so the Xcode project itself never changes.
def build_signed_app(xcconfig, build_number: nil)
  File.write(SIGNING_XCCONFIG, xcconfig)
  flutter('pub', 'get')
  flutter('build', 'macos', '--release', *(build_number ? ["--build-number=#{build_number}"] : []))
  UI.user_error!("No app at #{APP}") unless File.exist?(APP)
  sh('codesign', '--verify', '--deep', '--strict', APP)
ensure
  FileUtils.rm_f(SIGNING_XCCONFIG)
end

# The installer certificate that signs the .pkg for the Mac App Store. Apple
# names it "3rd Party Mac Developer Installer" or "Mac Installer Distribution"
# depending on when it was made.
def installer_identity
  found = sh('security', 'find-identity', '-v', log: false).lines.find do |line|
    line =~ /(3rd Party Mac Developer Installer|Mac Installer Distribution): .*\(M273PG74WU\)/
  end
  UI.user_error!('No Mac installer certificate in the keychain, run `fastlane mac appstore_setup`') unless found
  found[/[0-9A-F]{40}/]
end

platform :mac do
  desc 'Build the app signed with Developer ID and wrap it in a signed DMG'
  lane :build do
    install_certificate

    build_signed_app(<<~XCCONFIG)
      CODE_SIGN_STYLE = Manual
      CODE_SIGN_IDENTITY = Developer ID Application
      OTHER_CODE_SIGN_FLAGS = --timestamp
      // Xcode adds get-task-allow (debugger attach) otherwise, and the notary
      // service rejects any app that carries it
      CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
    XCCONFIG

    FileUtils.mkdir_p(DMG_DIR)
    FileUtils.rm_f(dmg_path)
    Dir.mktmpdir do |staging|
      # ditto, not cp: it keeps the framework symlinks the signature covers
      sh('ditto', APP, File.join(staging, "#{APP_NAME}.app"))
      File.symlink('/Applications', File.join(staging, 'Applications'))
      sh('hdiutil', 'create', '-volname', APP_NAME, '-srcfolder', staging,
         '-ov', '-format', 'UDZO', dmg_path)
    end
    sh('codesign', '--sign', signing_identity_of(APP), '--timestamp', dmg_path)
    UI.success("Built #{dmg_path}")
  end

  desc 'Put the Developer ID certificate into the match repo. Once, by hand, never on CI'
  desc 'cert: path to the .cer, p12: path to the .p12 with its private key and no password'
  lane :import_developer_id do |options|
    require 'match'
    # `fastlane match import` asks for the paths interactively; the importer
    # takes them directly. skip_certificate_matching: the certificate already
    # exists, so match must not look for (or create) one on the portal.
    params = FastlaneCore::Configuration.create(
      Match::Options.available_options,
      { type: 'developer_id', platform: 'macos', skip_certificate_matching: true, readonly: false }
    )
    params.load_configuration_file('Matchfile')
    # Developer ID needs no provisioning profile; an empty path skips it,
    # where nil would make match prompt for one
    Match::Importer.new.import_cert(params, cert_path: options[:cert], p12_path: options[:p12], profile_path: '')
  end

  desc 'Create the Mac App Store profile and the installer certificate'
  desc 'Once, by hand on a Mac, after `fastlane ios setup` registered the bundle id'
  lane :appstore_setup do
    # readonly false creates what is missing: the Mac App Store profile, and a
    # Mac Installer Distribution certificate for the .pkg. The Apple
    # Distribution certificate already in the repo signs the app itself.
    match(type: 'appstore', additional_cert_types: ['mac_installer_distribution'],
          readonly: false, api_key: asc_key)
  end

  desc 'Build the app for the Mac App Store and wrap it in a signed installer package'
  lane :appstore_build do |options|
    api_key = options[:api_key] || asc_key
    setup_ci
    match(type: 'appstore', additional_cert_types: ['mac_installer_distribution'],
          readonly: true, api_key: api_key)
    profile = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][APP_IDENTIFIER]
    build_number = latest_testflight_build_number(
      api_key: api_key, app_identifier: APP_IDENTIFIER, platform: 'osx', version: version,
      initial_build_number: 0
    ) + 1

    build_signed_app(<<~XCCONFIG, build_number: build_number)
      CODE_SIGN_STYLE = Manual
      CODE_SIGN_IDENTITY = Apple Distribution
      PROVISIONING_PROFILE_SPECIFIER = #{profile}
      // Xcode adds get-task-allow otherwise, which App Store Connect rejects
      CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
    XCCONFIG

    FileUtils.rm_f(PKG)
    sh('productbuild', '--component', APP, '/Applications', '--sign', installer_identity, PKG)
    UI.success("Built #{PKG}")
  end

  desc 'Build, upload with texts and screenshots, submit for review, release on approval'
  lane :appstore_release do
    api_key = asc_key
    appstore_build(api_key: api_key)
    upload_to_app_store(
      api_key: api_key,
      platform: 'osx',
      pkg: PKG,
      # fastlane/metadata and fastlane/screenshots (rendered by
      # test/store_screenshots) are the listing
      overwrite_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false,
      app_review_information: app_review_information(<<~NOTES),
        The Mac app is the receiving half of a pair: it lists the barcodes the
        iPhone app (same App Store record) scans and sends over the local
        network, and can type each one into the app in front, like a USB
        barcode scanner.

        To test, run the iPhone app on the same Wi-Fi, allow local network
        access on both, and scan any barcode. It appears in the Mac app's
        list. To see it typed, turn on Auto-Type in Settings: the app asks
        for permission to send keystrokes (listed under Accessibility) and
        applies it after the restart it offers. It types only the codes it
        receives and never reads the keyboard.

        The app has no account and collects no data.
      NOTES
      submit_for_review: true,
      automatic_release: true,
      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa: false
      }
    )
  end

  desc 'Build, notarize and staple the DMG'
  lane :release do
    api_key = asc_key
    build
    # Uploads to Apple's notary service, waits for the verdict and staples the
    # ticket to the DMG, so Gatekeeper accepts it offline too.
    notarize(package: dmg_path, api_key: api_key, print_log: true)
  end
end
